# Public Supabase settings. Vite inlines these at build time.
# Copy this file to .env.local for `npm run dev`, and set the same two
# variables in the Vercel project before deploying.
#
# Boda project ref: pkxgryaycnwpktsafodk
# Project Settings → Data API → Project URL
# Project Settings → API Keys → anon public key, or the publishable key.
# Never put the service_role or secret key here. It bypasses row level security.
VITE_SUPABASE_URL=https://pkxgryaycnwpktsafodk.supabase.co
VITE_SUPABASE_ANON_KEY=

# In-app feedback is filed by the /api/feedback function.
# Set LINEAR_API_KEY in the Vercel project (Production and Preview).
# Do not prefix it with VITE_, and do not commit the key. Vite never sees it.
